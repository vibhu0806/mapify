# ==============================================================================
# Jaipur -> Dehradun Vehicle Tracking - Environment Configuration
# ==============================================================================

# Backend Port & Environment
PORT=3001
NODE_ENV=development

# CORS Allowed Origin (Frontend URL)
CORS_ORIGIN=http://localhost:3000

# Administrator Authentication Key / Secret
ADMIN_SECRET=admin_jaipur_dehradun_secure_key_2026

# Supabase PostgreSQL Configuration
# If left empty, backend automatically uses persistent local memory store
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# OSRM Routing Engine Base URL
# Uses public OSRM by default; can be pointed to a self-hosted OSRM backend
OSRM_ROUTER_URL=https://router.project-osrm.org

# Frontend Configuration
VITE_API_BASE_URL=/api
# Configurable OpenStreetMap / Tile Layer Provider
VITE_TILE_LAYER_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
